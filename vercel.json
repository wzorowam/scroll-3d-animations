{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/watch", "destination": "/watch.html" },
    { "source": "/watch/", "destination": "/watch.html" },
    { "source": "/car", "destination": "/car.html" },
    { "source": "/car/", "destination": "/car.html" }
  ]
}
