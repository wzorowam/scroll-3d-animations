{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/watch", "destination": "/watch.html" },
    { "source": "/watch/", "destination": "/watch.html" },
    { "source": "/sneaker", "destination": "/sneaker.html" },
    { "source": "/sneaker/", "destination": "/sneaker.html" }
  ]
}
